# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://pm_agent:change-me@localhost:5432/pm_agent_dev

# Slack app credentials
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Optional; only required for Socket Mode.
SLACK_APP_TOKEN=

# Language model and embeddings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small

# Optional read-only GitHub API token for private repositories or higher limits
GITHUB_TOKEN=

# Comma-separated Slack user IDs allowed to run administrative commands
GLOBAL_ADMIN_SLACK_IDS=

LOG_LEVEL=INFO
